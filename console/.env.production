VITE_BASE_URL=/

VITE_APP_TITLE=观势台

VITE_APP_DESC=观势台 · 观势数据层

VITE_ICON_PREFIX=icon

VITE_ICON_LOCAL_PREFIX=icon-local

VITE_AUTH_ROUTE_MODE=static

VITE_ROUTE_HOME=/home

VITE_MENU_ICON=mdi:menu

VITE_HTTP_PROXY=N

VITE_ROUTER_HISTORY_MODE=history

VITE_SERVICE_SUCCESS_CODE=0

VITE_SERVICE_LOGOUT_CODES=8888,8889

VITE_SERVICE_MODAL_LOGOUT_CODES=7777,7778

VITE_SERVICE_EXPIRED_TOKEN_CODES=9999,9998,3333

# 公开看板口令，编进前端包。网关目前不校验。
VITE_PUBLIC_CATALYST_TOKEN=guanshi-public
VITE_PUBLIC_CATALYST_AES_KEY=LtPublicCatalyst
VITE_PUBLIC_CATALYST_AES_IV=LtPublicCatIv16!

VITE_STATIC_SUPER_ROLE=R_SUPER

VITE_SOURCE_MAP=N

VITE_STORAGE_PREFIX=GS_

VITE_AUTOMATICALLY_DETECT_UPDATE=Y

# 空字符串 = 同源。页面和 /api、/auth 都走容器 80，由容器 nginx 转到 market-api。
# 不能写成 127.0.0.1:8787，否则外网浏览器会去访问自己的本机。
VITE_SERVICE_BASE_URL=

VITE_OTHER_SERVICE_BASE_URL= `{
  "demo": "http://localhost:9528"
}`

VITE_PROXY_LOG=N
