FROM python:3.12-slim
WORKDIR /app

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev && \
    rm -rf /var/lib/apt/lists/*

# Python deps
COPY ops/requirements-worker.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Application code
COPY dworker/ /app/dworker/
COPY dsched/ /app/dsched/
COPY configs/ /app/configs/

ENV PYTHONPATH=/app
ENV TZ=Asia/Shanghai

CMD ["python", "-c", "print('market-worker/sched ready')"]
