FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends python3 ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g @deepseek-ai/dsh@0.2.0-rc.2 pnpm@10

WORKDIR /opt/guanshi
COPY dsh /opt/guanshi/dsh
COPY ops/dsh-entrypoint.sh /usr/local/bin/dsh-entrypoint.sh
RUN chmod +x /usr/local/bin/dsh-entrypoint.sh /opt/guanshi/dsh/scripts/install.sh

ENV DSH_HOME=/data
ENV DSH_AGENTS_HOME=/data/agents
VOLUME /data
EXPOSE 3080
ENTRYPOINT ["/usr/local/bin/dsh-entrypoint.sh"]
