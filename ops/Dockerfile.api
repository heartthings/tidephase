FROM python:3.12-slim
WORKDIR /app

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev && \
    rm -rf /var/lib/apt/lists/*

# Python deps
COPY ops/requirements-api.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Application code
COPY data_api/ /app/data_api/
COPY dsh/spec/ /app/dsh/spec/
COPY configs/ /app/configs/

ENV PYTHONPATH=/app
ENV TZ=Asia/Shanghai

EXPOSE 8787

CMD ["python", "-c", "print('market-api placeholder - Z2 wave will implement')"]
